STARTGG_CLIENT_ID=YOUR_STARTGG_CLIENT_ID
# start.gg's token endpoint requires the secret even with PKCE.
STARTGG_CLIENT_SECRET=YOUR_STARTGG_CLIENT_SECRET
# STARTGG_AUTH_ENDPOINT=https://api.start.gg/oauth/authorize
# STARTGG_TOKEN_ENDPOINT=https://api.start.gg/oauth/access_token
# Must match the callback registered on your Start.gg app exactly.
STARTGG_REDIRECT_URI=http://localhost:3000/api/auth/startgg/callback

NEXT_PUBLIC_STARTGG_CLIENT_ID=YOUR_STARTGG_CLIENT_ID
NEXT_PUBLIC_STARTGG_REDIRECT_URI=http://localhost:3000/api/auth/startgg/callback
