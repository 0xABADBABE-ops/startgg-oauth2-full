{
  "name": "startgg-oauth2-full",
  "version": "0.2.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/StartGGOAuth2.d.ts",
      "import": "./dist/auth/StartGGOAuth2.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "scripts": {
    "dev:browser": "serve examples/browser -p 5174",
    "dev:node": "tsx examples/node/index.ts",
    "dev:node:server": "tsx examples/node/server.ts",
    "dev:vite": "cd examples/vite && npm run dev",
    "dev:nextjs": "cd examples/nextjs && npm run dev",
    "dev:discord": "cd examples/discordjs && npm run dev",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.7.5",
    "jest": "^29.7.0",
    "node-fetch": "^3.3.2",
    "serve": "^14.2.6",
    "ts-jest": "^29.2.5",
    "ts-node": "10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
